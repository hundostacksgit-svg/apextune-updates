{
  "name": "omnidx-studio-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Optional backend for OmniDx Studio: accounts, devices, licences and the cloud AI planner.",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create omnidx-studio",
    "db:init": "wrangler d1 execute omnidx-studio --file=schema.sql --remote",
    "db:init-local": "wrangler d1 execute omnidx-studio --file=schema.sql --local",
    "tail": "wrangler tail"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.72.0"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  }
}
