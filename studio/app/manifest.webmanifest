{
  "name": "OmniDx Studio",
  "short_name": "OmniDx Studio",
  "description": "A full multitrack video editor with a built-in AI editor. Works offline. Your footage never leaves your device.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#04060d",
  "theme_color": "#04060d",
  "categories": ["photo", "video", "productivity", "graphics"],
  "icons": [
    { "src": "../assets/mark.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" },
    { "src": "../../icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "../../icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "../../icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "New project", "url": "./?new=1" },
    { "name": "AI editor", "url": "./?panel=ai" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": {
        "video/*": [".mp4", ".mov", ".webm", ".mkv", ".m4v"],
        "audio/*": [".mp3", ".wav", ".m4a", ".aac", ".ogg"],
        "image/*": [".jpg", ".jpeg", ".png", ".webp", ".gif"]
      }
    }
  ],
  "share_target": {
    "action": "./",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": { "files": [{ "name": "media", "accept": ["video/*", "image/*", "audio/*"] }] }
  }
}
